{
  "name": "webnexa---multi-vendor-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "kill-port 5000 5173 24678",
    "dev": "concurrently --kill-others-on-fail --prefix \"[{name}]\" -n \"CLIENT,SERVER\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:client\" \"npm run dev:server\"",
    "client": "wait-on http://127.0.0.1:5000/api/health && vite",
    "dev:client": "npm run client",
    "dev:server": "npm run server",
    "server": "node server.js",
    "build:server": "esbuild server.js --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build": "vite build && npm run build:server",
    "test:compat": "node --test server/utils/legacyData.test.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@paystack/inline-js": "^2.25.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.52.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.0",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "kill-port": "^2.0.1",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  }
}
